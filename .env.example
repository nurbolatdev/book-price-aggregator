# Copy to .env and fill in values. .env is NOT committed to git.

# PostgreSQL
POSTGRES_DB=bookaggregator
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=changeme
# Host port for PostgreSQL (bound to 127.0.0.1); change if 5432 is taken by a local install
POSTGRES_HOST_PORT=5432

# Backend datasource
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bookaggregator
DB_USERNAME=bookuser
DB_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# Host port for Redis (bound to 127.0.0.1); change if 6379 is taken by another project
REDIS_HOST_PORT=6379

# RabbitMQ (broker for parsing and price events; use localhost when running backend from host)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Management API, used by the admin queue view (use http://localhost:15672 when running backend from host)
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# Mail (SMTP; in dev this is Mailpit, web UI at http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
# Sender of all emails
MAIL_FROM=KitapRadar <no-reply@kitapradar.kz>

# Public URL of the frontend, used in links inside emails
APP_BASE_URL=http://localhost
# Browser origins allowed to call the API (comma-separated); docker: http://localhost, Vite dev server: http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost

# JWT: HMAC key of access tokens (at least 32 characters), life of access and refresh tokens
JWT_SECRET=change_me_use_long_random_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Signed-in devices per user; a new sign-in over the limit ends the least recently used session
JWT_MAX_SESSIONS=10

# Request rate limits (login 5/min, registration and password reset 3/min, search 60/min, other API 120/min)
RATE_LIMIT_ENABLED=true

# First administrator, created on startup if no account with this email exists (both empty — none)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# External API keys (will be set in M2)
GOOGLE_BOOKS_API_KEY=

# Headless Chromium for stores rendered by JavaScript (Kaspi, Wildberries, Ozon). The backend image includes it;
# when the backend runs from the host, it is off unless set (needs a Playwright Chromium installed there)
PARSER_BROWSER_ENABLED=true

# Load the demo catalog (books, offers, price history) on startup; for local development only
APP_DEV_SEED=false

# Скопируй в .env и подставь значения. .env в git НЕ коммитится.

# PostgreSQL
POSTGRES_DB=bookaggregator
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=change_me

# Backend datasource (используется в application-docker.yml)
DB_URL=jdbc:postgresql://postgres:5432/bookaggregator
DB_USERNAME=bookuser
DB_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (заполнится на M5)
JWT_SECRET=change_me_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=3600000

# External sources (заполнится на M2)
GOOGLE_BOOKS_API_KEY=
